# Скопіюйте цей файл у .env і заповніть значення.
# .env знаходиться в .gitignore і ніколи не потрапляє в git.

# --- MetaTrader 5 ---
# Шлях до terminal64.exe (якщо порожньо — MetaTrader5 сам знайде запущений термінал)
MT5_TERMINAL_PATH=
# Логін торгового рахунку (число)
MT5_LOGIN=
# Пароль рахунку
MT5_PASSWORD=
# Сервер брокера, наприклад: FundingPips-Server
MT5_SERVER=

# --- Telegram ---
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# ID чату для сповіщень (можна отримати через @userinfobot)
TELEGRAM_CHAT_ID=
